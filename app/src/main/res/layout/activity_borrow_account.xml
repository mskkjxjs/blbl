<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/blblPageBackdrop"
    android:paddingVertical="20dp">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.05" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_qr_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.35" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_panel_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.40" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_panel_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.96" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.06" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.94" />

    <ImageView
        android:id="@+id/iv_qr"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/colorSurface"
        android:contentDescription="小号登录二维码"
        android:padding="8dp"
        android:scaleType="fitCenter"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@id/guideline_qr_end"
        app:layout_constraintStart_toStartOf="@id/guideline_left"
        app:layout_constraintTop_toBottomOf="@id/guideline_top" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="2dp"
        android:textColor="?attr/blblOnPageBackdropSecondary"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@id/guideline_qr_end"
        app:layout_constraintStart_toStartOf="@id/guideline_left"
        app:layout_constraintTop_toBottomOf="@id/iv_qr" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_qr"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="扫码登录小号"
        app:layout_constraintEnd_toStartOf="@id/guideline_qr_end"
        app:layout_constraintStart_toStartOf="@id/guideline_left"
        app:layout_constraintTop_toBottomOf="@id/tv_status" />

    <ScrollView
        android:id="@+id/panel_right"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/guideline_bottom"
        app:layout_constraintEnd_toStartOf="@id/guideline_panel_end"
        app:layout_constraintStart_toStartOf="@id/guideline_panel_start"
        app:layout_constraintTop_toBottomOf="@id/guideline_top">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="取流设置"
                android:textColor="?attr/blblOnPageBackdrop"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:textColor="?attr/blblOnPageBackdropSecondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="SESSDATA（必填）"
                android:textColor="?attr/blblOnPageBackdrop"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/et_sessdata"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="?attr/blblFocusBgRound"
                android:gravity="center_vertical"
                android:hint="粘贴 SESSDATA 值或整段 Cookie"
                android:imeOptions="actionNext"
                android:includeFontPadding="false"
                android:inputType="textVisiblePassword|textNoSuggestions"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="?attr/blblOnPageBackdrop"
                android:textColorHint="?attr/blblOnPageBackdropSecondary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="bili_jct（用于自动续期）"
                android:textColor="?attr/blblOnPageBackdrop"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/et_bili_jct"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="?attr/blblFocusBgRound"
                android:gravity="center_vertical"
                android:hint="可留空；留空则无法自动续期"
                android:imeOptions="actionNext"
                android:includeFontPadding="false"
                android:inputType="textVisiblePassword|textNoSuggestions"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="?attr/blblOnPageBackdrop"
                android:textColorHint="?attr/blblOnPageBackdropSecondary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="ac_time_value（用于自动续期）"
                android:textColor="?attr/blblOnPageBackdrop"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/et_ac_time"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="?attr/blblFocusBgRound"
                android:gravity="center_vertical"
                android:hint="扫码登录会自动填入；手填可留空"
                android:imeOptions="actionDone"
                android:includeFontPadding="false"
                android:inputType="textVisiblePassword|textNoSuggestions"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="?attr/blblOnPageBackdrop"
                android:textColorHint="?attr/blblOnPageBackdropSecondary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="2dp"
                android:text="扫码成功后会自动填入以上三项。取流仅使用小号，观看历史、弹幕与互动仍使用当前帐号。"
                android:textColor="?attr/blblOnPageBackdropSecondary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="保存并校验" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="返回"
                app:backgroundTint="#444444" />

        </LinearLayout>

    </ScrollView>

    <TextView
        android:id="@+id/tv_debug"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.55"
        android:textColor="?attr/blblOnPageBackdropSecondary"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
